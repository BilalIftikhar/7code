# Final site address, no trailing slash. Drives canonicals, sitemap, share images and schema.
NEXT_PUBLIC_SITE_URL=https://7code.agency

# Contact form email delivery (https://resend.com). Without these, the form
# hands enquiries off to WhatsApp instead of sending email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=        # inbox that receives enquiries
CONTACT_FROM_EMAIL=      # verified sender, e.g. "7CODE Website <hello@yourdomain.com>"
